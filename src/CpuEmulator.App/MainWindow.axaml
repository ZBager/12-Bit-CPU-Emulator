<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:local="clr-namespace:CpuEmulator.App"
		x:Class="CpuEmulator.App.MainWindow"
		Title="CPU Emulator" Icon="/Assets/cpuemulator.ico"
		Height="560" Width="1040" MinWidth="900" MinHeight="440">

	<Grid Background="LightBlue">
		<Grid.RowDefinitions>
			<RowDefinition Height="50" />
			<RowDefinition Height="20" />
			<RowDefinition />
			<RowDefinition Height="26" />
		</Grid.RowDefinitions>

		<!-- Top Bar -->
		<Grid Grid.Row="0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="55" />
				<ColumnDefinition Width="50" />
				<ColumnDefinition Width="50" />
				<ColumnDefinition Width="50" />
				<ColumnDefinition Width="50" />
				<ColumnDefinition Width="1*" />
			</Grid.ColumnDefinitions>
			<Button Grid.Column="0" Margin="10,5,5,5" Click="Load_Program">
				<TextBlock Text="Load&#x0a;Program" TextAlignment="Center" FontSize="9" />
			</Button>
			<Button Grid.Column="1" Margin="5" Click="Next_Tick" x:Name="stepButton">
				<TextBlock Text="Next&#x0a;Step" TextAlignment="Center" FontSize="9" />
			</Button>
			<Button Grid.Column="2" Margin="5" Click="Start_CPU" x:Name="runButton">
				<TextBlock Text="Run" TextAlignment="Center" FontSize="9" />
			</Button>
			<Button Grid.Column="3" Margin="5" Click="Stop_CPU" x:Name="stopButton" IsEnabled="False">
				<TextBlock Text="Stop" TextAlignment="Center" FontSize="9" />
			</Button>
			<Button Grid.Column="4" Margin="5" Click="Reset_CPU" x:Name="resetButton">
				<TextBlock Text="Reset" TextAlignment="Center" FontSize="9" />
			</Button>
		</Grid>

		<!-- Column headings -->
		<Grid Grid.Row="1">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="1*" />
				<ColumnDefinition Width="1*" />
				<ColumnDefinition Width="1.3*" />
			</Grid.ColumnDefinitions>
			<TextBlock Grid.Column="0" Text="Registers" HorizontalAlignment="Center" VerticalAlignment="Bottom" FontSize="12" />
			<TextBlock Grid.Column="1" Text="Ram" HorizontalAlignment="Center" VerticalAlignment="Bottom" FontSize="12" />
			<TextBlock Grid.Column="2" Text="Programmer" HorizontalAlignment="Center" VerticalAlignment="Bottom" FontSize="12" />
		</Grid>

		<!-- Main Part -->
		<Grid Grid.Row="2">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="1*" />
				<ColumnDefinition Width="1*" />
				<ColumnDefinition Width="1.3*" />
			</Grid.ColumnDefinitions>

			<DataGrid Grid.Column="0" Margin="10" x:Name="regData"
					  x:DataType="local:MemoryRow"
					  AutoGenerateColumns="False" IsReadOnly="True"
					  CanUserSortColumns="False" Opacity="0.70"
					  FontFamily="monospace" FontSize="12" RowHeight="20"
					  GridLinesVisibility="Horizontal">
				<DataGrid.Columns>
					<DataGridTextColumn Header="Addr" Width="70" Binding="{Binding Address}" />
					<DataGridTextColumn Header="Hex" Width="70" Binding="{Binding Hex}" />
					<DataGridTextColumn Header="Binary" Width="1*" Binding="{Binding Binary}" />
				</DataGrid.Columns>
			</DataGrid>

			<DataGrid Grid.Column="1" Margin="10" x:Name="ramData"
					  x:DataType="local:MemoryRow"
					  AutoGenerateColumns="False" IsReadOnly="True"
					  CanUserSortColumns="False" Opacity="0.70"
					  FontFamily="monospace" FontSize="12" RowHeight="20"
					  GridLinesVisibility="Horizontal">
				<DataGrid.Columns>
					<DataGridTextColumn Header="Addr" Width="70" Binding="{Binding Address}" />
					<DataGridTextColumn Header="Hex" Width="70" Binding="{Binding Hex}" />
					<DataGridTextColumn Header="Binary" Width="1*" Binding="{Binding Binary}" />
				</DataGrid.Columns>
			</DataGrid>

			<!-- Right Half: the program editor that was never built. Carried over from the
				 WPF layout as an explicit placeholder rather than as controls that look
				 usable but do nothing. -->
			<Grid Grid.Column="2">
				<Grid.RowDefinitions>
					<RowDefinition />
					<RowDefinition Height="30" />
				</Grid.RowDefinitions>
				<DataGrid Grid.Row="0" Margin="10" x:Name="programerData" Opacity="0.70" IsEnabled="False">
					<DataGrid.Columns>
						<DataGridTextColumn Header="Address" Width="1*" />
						<DataGridTextColumn Header="Argument 1" Width="1*" />
						<DataGridTextColumn Header="Argument 2" Width="1*" />
						<DataGridTextColumn Header="Argument 3" Width="1*" />
					</DataGrid.Columns>
				</DataGrid>
				<Grid Grid.Row="1">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="1*" />
					</Grid.ColumnDefinitions>
					<StackPanel Grid.Column="0" Orientation="Horizontal" Margin="10,0,0,5" Spacing="5">
						<Button Content="Up" FontSize="9" IsEnabled="False" />
						<Button Content="Down" FontSize="9" IsEnabled="False" />
						<Button Content="Write" FontSize="9" IsEnabled="False" />
					</StackPanel>
					<TextBlock Grid.Column="1" Text="Program editor — not implemented"
							   VerticalAlignment="Center" HorizontalAlignment="Right"
							   Margin="0,0,12,5" FontSize="11" Opacity="0.6" />
				</Grid>
			</Grid>
		</Grid>

		<!-- Status bar. The core now reports invalid opcodes as exceptions, so there
			 has to be somewhere for them to surface. -->
		<Border Grid.Row="3" Background="#33000000">
			<Grid Margin="10,0">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="1*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<TextBlock Grid.Column="0" x:Name="statusText" VerticalAlignment="Center" FontSize="11" />
				<TextBlock Grid.Column="1" x:Name="cpuStateText" VerticalAlignment="Center" FontSize="11"
						   FontFamily="monospace" />
			</Grid>
		</Border>
	</Grid>
</Window>
